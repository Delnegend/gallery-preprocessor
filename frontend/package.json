{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"reka-ui": "^2.3.1",
		"tailwind-merge": "^3.3.1",
		"vue": "^3.5.16"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/node": "latest",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/tsconfig": "^0.7.0",
		"autoprefixer": "^10.4.21",
		"oxlint": "^1.8.0",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^3.4.17",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "~5.8.3",
		"vite": "^6.3.5",
		"vue-tsc": "^2.2.10"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"tabWidth": 4,
		"useTabs": true,
		"plugins": [
			"prettier-plugin-tailwindcss",
			"@trivago/prettier-plugin-sort-imports"
