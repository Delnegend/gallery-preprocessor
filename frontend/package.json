	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.4.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"oxlint": "^1.80.0",
